{
  "name": "tintly",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Tintly - Dark Mode & Reading Modes: a fast, private dark and light theme for web pages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehsanenaloo/Tintly.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "validate": "node scripts/validate.mjs",
    "types": "tsc --noEmit -p tsconfig.json",
    "check": "npm run validate && npm run data:check && npm run types && npm test",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "lint:firefox": "node scripts/lint-firefox.mjs",
    "audit": "npm audit --audit-level=high",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.mjs\"",
    "version:status": "node scripts/version.mjs status",
    "version:bump": "node scripts/version.mjs bump",
    "version:check": "node scripts/version.mjs check",
    "hooks:install": "node scripts/version.mjs hook",
    "test:browser:parallel": "node scripts/test-browser.mjs",
    "test:firefox": "node --test --test-concurrency=1 \"tests/firefox/*.test.mjs\"",
    "test:perf": "node tests/perf/run.mjs",
    "data:build": "node scripts/data/build.mjs",
    "data:check": "node scripts/data/build.mjs --check",
    "data:crawl": "node scripts/data/crawl.mjs",
    "data:report": "node scripts/data/report.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "addons-linter": "10.14.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
